# ---- Build output ----
bin/
obj/
publish/
release/
*.user
*.suo
.vs/

# ---- Native build artifacts ----
native/build/
*.obj
*.exe
*.pdb

# ---- Runtime data & caches ----
*.cache
history.json
settings.json
*.log
*.tmp
__pycache__/

# ---- Scratch scripts & screenshots at repo root ----
/*.py
/*.png
/*.bat

# ---- Local dev probes (not part of the shipped app) ----
/dwmtest/
/native_probe/
/wpf_test/
/_shots/

# ---- Native scratch files (keep build.bat, src/, README.md) ----
/native/*.py
/native/*.png
/native/*.bmp

# ---- Keep README assets ----
!assets/**
