# ---- Build output ----
bin/
obj/
publish/
release/
*.user
*.suo
.vs/

# ---- Native build artifacts ----
native/build/
*.obj
*.exe
*.pdb

# ---- Runtime data & caches ----
*.cache
history.json
settings.json
*.log
*.tmp
__pycache__/

# ---- Scratch scripts & screenshots at repo root ----
/*.py
/*.png
/*.bat

# ---- Local dev probes (not part of the shipped app) ----
/dwmtest/
/native_probe/
/wpf_test/
/_shots/

# ---- ATK 抓包取证（本地一次性材料，含厂商驱动 bundle，不入库）----
#   tools/capture_atk_hid.py 是抓包脚本本身，值得保留；
#   下面这些是它抓下来的原始记录与站点资源。
/_atk/
/_atk_hub.html
/tools/_atk_*.jsonl
/tools/_atk_*.py

# ---- Native scratch files (keep build.bat, src/, README.md) ----
/native/*.py
/native/*.png
/native/*.bmp

# ---- Keep README assets ----
!assets/**
