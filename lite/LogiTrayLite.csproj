<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 鍙惎鐢?WinForms锛氫笉寮曞叆 WPF锛岃繖鏄交閲忕増鐪佸唴瀛樼殑鍏抽敭 -->
    <UseWPF>false</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>logi-tray-lite</AssemblyName>
    <Product>logi-tray-lite</Product>
    <Title>logi-tray-lite</Title>
    <Version>1.2.0</Version>
    <RootNamespace>MouseBatteryTray.Lite</RootNamespace>
    <StartupObject>MouseBatteryTray.Lite.Program</StartupObject>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- WinForms 鑷甫鐨?Application.SetHighDpiMode 鐢?app.manifest 璐熻矗锛岄伩鍏嶉噸澶嶉厤缃憡璀?-->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 涓庡畬鏁寸増鍏辩敤鍚屼竴浠芥牳蹇冩簮鐮侊紝閬垮厤澶嶅埗鍒嗗弶 -->
    <Compile Include="..\shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- 鍏充簬椤靛睍绀虹殑 512脳512 搴旂敤鍥炬爣锛氭棦浣滀负璧勬簮鍐呭祵锛屼篃澶嶅埗涓€浠戒究浜庡閮ㄨ鍙?-->
    <Resource Include="app.png" />
    <Content Include="app.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!--
      鍘熺敓 HID++ 璇诲彇绋嬪簭銆傚畠鐢?native/ 鍗曠嫭缂栬瘧锛屼笉灞炰簬鏈」鐩殑婧愮爜锛?
      浣嗚繍琛屾椂蹇呴』涓庝富绋嬪簭鍚岀洰褰曪紝鍚﹀垯璇讳笉鍒扮數閲忥紙浼氫竴鐩存樉绀虹绾匡級銆?
    -->
    <Content Include="..\native\build\mouse-tray.exe" Link="mouse-tray.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
