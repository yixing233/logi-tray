<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      与完整版一致启用 WPF：多品牌版复用同一套亚克力 Fluent 外观层
      （shared-wpf/ThemeService.cs + FluentStyles.xaml），不再用朴素 WinForms。
    -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>multi-tray</AssemblyName>
    <Product>multi-tray</Product>
    <Title>multi-tray</Title>
    <Version>1.1.0</Version>
    <RootNamespace>MultiTray</RootNamespace>
    <StartupObject>MultiTray.Program</StartupObject>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 与罗技版共用同一套身份/自启/配色源码，避免三份实现漂移 -->
    <Compile Include="..\shared\AppIdentity.cs" LinkBase="Shared" />
    <Compile Include="..\shared\AppPalette.cs" LinkBase="Shared" />
    <Compile Include="..\shared\AutoStartService.cs" LinkBase="Shared" />
    <Compile Include="..\shared\UnmanagedMethods.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <!--
      直接引用完整版（wpf/）的 ThemeService，**不复制**。
      复制会产生两份真相并逐渐漂移（实测复制后两文件哈希立刻不同）。
      这样 wpf/ 一个字节都不用改，multi-tray 也必然与它主题一致。

      卡片构建块（DeviceCardWidgets.cs）是本项目自己的文件，
      由 SDK 默认包含，无需在此声明。
    -->
    <Compile Include="..\wpf\ThemeService.cs" LinkBase="SharedWpf" />
  </ItemGroup>

  <ItemGroup>
    <!-- 允许界面自检宿主访问 internal 类型，用于注入合成快照核对布局 -->
    <InternalsVisibleTo Include="multishot" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Lucide 图标字体：直接引用完整版那份，避免重复 858KB -->
    <Content Include="..\wpf\Fonts\lucide.ttf" Link="Fonts\lucide.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!--
      罗技读取程序。它是本工具读取罗技设备电量的唯一实现，
      必须与主程序同目录，否则罗技那一栏会一直显示离线。
    -->
    <Content Include="..\native\build\mouse-tray.exe" Link="mouse-tray.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    FluentStyles.xaml 由项目内的副本提供（WPF 的 pack URI 对跨项目链接的 XAML
    解析不稳健，因此保留项目内副本）。内容在构建前从完整版的唯一真相
    wpf/FluentStyles.xaml 同步过来，保证两版样式必然一致。
  -->
  <Target Name="SyncFluentStyles" BeforeTargets="BeforeBuild">
    <Copy SourceFiles="..\wpf\FluentStyles.xaml"
          DestinationFiles="FluentStyles.xaml"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
