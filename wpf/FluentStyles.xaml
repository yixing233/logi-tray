<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 默认初始画刷 (若未注入则作为安全回退) -->
    <SolidColorBrush x:Key="ThemeTextPrimary" Color="#0F172A"/>
    <SolidColorBrush x:Key="ThemeTextSecondary" Color="#475569"/>
    <SolidColorBrush x:Key="ThemeTextFaint" Color="#64748B"/>
    <SolidColorBrush x:Key="ThemeCardBackground" Color="#0A000000"/>
    <SolidColorBrush x:Key="ThemeCardBorder" Color="#15000000"/>
    <SolidColorBrush x:Key="ThemeButtonSecondaryBackground" Color="#12000000"/>
    <SolidColorBrush x:Key="ThemeButtonSecondaryForeground" Color="#0F172A"/>
    <SolidColorBrush x:Key="ThemeButtonSecondaryHoverBackground" Color="#22000000"/>
    <SolidColorBrush x:Key="ThemeButtonSecondaryHoverForeground" Color="#000000"/>
    <SolidColorBrush x:Key="ThemeSliderTrackBackground" Color="#26000000"/>
    <SolidColorBrush x:Key="ThemeTogglePillBackground" Color="#15000000"/>
    <SolidColorBrush x:Key="ThemeTogglePillBorder" Color="#707070"/>
    <SolidColorBrush x:Key="ThemeToggleKnobFill" Color="#555555"/>

    <!-- 1. Windows 11 Fluent Slider Style (底轨自适应深浅色，永不发暗或糊化) -->
    <Style x:Key="FluentSliderStyle" TargetType="Slider">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" ClipToBounds="False">
                        <!-- 底轨 Background Track (动态适应深浅模式) -->
                        <Border Height="4" CornerRadius="2"
                                Background="{DynamicResource ThemeSliderTrackBackground}"
                                VerticalAlignment="Center" HorizontalAlignment="Stretch"/>

                        <!-- 交互滑道 Interactive Track -->
                        <Track x:Name="PART_Track" Height="18" VerticalAlignment="Center" ClipToBounds="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                    <RepeatButton.Style>
                                        <Style TargetType="RepeatButton">
                                            <Setter Property="OverridesDefaultStyle" Value="True"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="IsTabStop" Value="False"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Height="4" Background="#0067C0" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,-9,0"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </RepeatButton.Style>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                    <RepeatButton.Style>
                                        <Style TargetType="RepeatButton">
                                            <Setter Property="OverridesDefaultStyle" Value="True"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="IsTabStop" Value="False"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Background="Transparent"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </RepeatButton.Style>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Style>
                                        <Style TargetType="Thumb">
                                            <Setter Property="OverridesDefaultStyle" Value="True"/>
                                            <Setter Property="Height" Value="18"/>
                                            <Setter Property="Width" Value="18"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="False">
                                                            <Ellipse x:Name="OuterThumb" Width="18" Height="18"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                     Fill="#FFFFFF" Stroke="#C8C8C8" StrokeThickness="1">
                                                                <Ellipse.Effect>
                                                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.18" Color="Black"/>
                                                                </Ellipse.Effect>
                                                            </Ellipse>
                                                            <Ellipse x:Name="InnerDot" Width="6" Height="6"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                     Fill="#0067C0"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="OuterThumb" Property="Stroke" Value="#0067C0"/>
                                                                <Setter TargetName="InnerDot" Property="Width" Value="8"/>
                                                                <Setter TargetName="InnerDot" Property="Height" Value="8"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="OuterThumb" Property="Fill" Value="#FAFAFA"/>
                                                                <Setter TargetName="OuterThumb" Property="Stroke" Value="#0067C0"/>
                                                                <Setter TargetName="InnerDot" Property="Width" Value="8"/>
                                                                <Setter TargetName="InnerDot" Property="Height" Value="8"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Thumb.Style>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 2. 严重警告滑块样式 (红色激活轨 + 红色指示点) -->
    <Style x:Key="FluentCriticalSliderStyle" TargetType="Slider" BasedOn="{StaticResource FluentSliderStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" ClipToBounds="False">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource ThemeSliderTrackBackground}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                        <Track x:Name="PART_Track" Height="18" VerticalAlignment="Center" ClipToBounds="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                    <RepeatButton.Style>
                                        <Style TargetType="RepeatButton">
                                            <Setter Property="OverridesDefaultStyle" Value="True"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="IsTabStop" Value="False"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Height="4" Background="#DC2626" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,-9,0"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </RepeatButton.Style>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                    <RepeatButton.Style>
                                        <Style TargetType="RepeatButton">
                                            <Setter Property="OverridesDefaultStyle" Value="True"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="IsTabStop" Value="False"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Background="Transparent"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </RepeatButton.Style>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Style>
                                        <Style TargetType="Thumb">
                                            <Setter Property="OverridesDefaultStyle" Value="True"/>
                                            <Setter Property="Height" Value="18"/>
                                            <Setter Property="Width" Value="18"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="False">
                                                            <Ellipse x:Name="OuterThumb" Width="18" Height="18"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                     Fill="#FFFFFF" Stroke="#C8C8C8" StrokeThickness="1">
                                                                <Ellipse.Effect>
                                                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.18" Color="Black"/>
                                                                </Ellipse.Effect>
                                                            </Ellipse>
                                                            <Ellipse x:Name="InnerDot" Width="6" Height="6"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                     Fill="#DC2626"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="OuterThumb" Property="Stroke" Value="#DC2626"/>
                                                                <Setter TargetName="InnerDot" Property="Width" Value="8"/>
                                                                <Setter TargetName="InnerDot" Property="Height" Value="8"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="OuterThumb" Property="Fill" Value="#FAFAFA"/>
                                                                <Setter TargetName="OuterThumb" Property="Stroke" Value="#DC2626"/>
                                                                <Setter TargetName="InnerDot" Property="Width" Value="8"/>
                                                                <Setter TargetName="InnerDot" Property="Height" Value="8"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Thumb.Style>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 3. Windows 11 现代 ToggleSwitch 胶囊开关样式 (随深浅模式自动反转边框与把手) -->
    <Style x:Key="FluentToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <!-- 胶囊外壳 -->
                        <Border x:Name="SwitchPill" Width="40" Height="20" CornerRadius="10"
                                BorderThickness="1.5"
                                BorderBrush="{DynamicResource ThemeTogglePillBorder}"
                                Background="{DynamicResource ThemeTogglePillBackground}">
                            <!-- 内部滑动圆圈 -->
                            <Canvas Width="40" Height="20" ClipToBounds="True">
                                <Ellipse x:Name="SwitchKnob" Width="12" Height="12"
                                         Fill="{DynamicResource ThemeToggleKnobFill}"
                                         Canvas.Left="3" Canvas.Top="2.5">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="0.5" Direction="270" Opacity="0.25" Color="Black"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Canvas>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 开启状态 -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchPill" Property="Background" Value="#0067C0"/>
                            <Setter TargetName="SwitchPill" Property="BorderBrush" Value="#0067C0"/>
                            <Setter TargetName="SwitchKnob" Property="Fill" Value="White"/>
                            <Setter TargetName="SwitchKnob" Property="Canvas.Left" Value="22"/>
                        </Trigger>
                        <!-- 鼠标悬停 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SwitchPill" Property="Background" Value="#1870B8"/>
                            <Setter TargetName="SwitchPill" Property="BorderBrush" Value="#1870B8"/>
                            <Setter TargetName="SwitchKnob" Property="Fill" Value="White"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 4. 主操作按钮样式 (保存设置 / 选中项：鲜明蓝底白字) -->
    <Style x:Key="FluentPrimaryButtonStyle" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" CornerRadius="5" Background="#0067C0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#1870B8"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#005A9E"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 5. 次级操作按钮样式 (取消 / 未选中项：深浅模式完全自适应，深色模式纯白字+透光白底，绝不黑上黑) -->
    <Style x:Key="FluentSecondaryButtonStyle" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeButtonSecondaryForeground}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" CornerRadius="5"
                            Background="{DynamicResource ThemeButtonSecondaryBackground}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ThemeCardBorder}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ThemeButtonSecondaryHoverBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ThemeButtonSecondaryHoverForeground}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#400078D4"/>
                            <Setter Property="Foreground" Value="{DynamicResource ThemeButtonSecondaryHoverForeground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 6. 分段选择按钮样式 -->
    <Style x:Key="FluentSegmentedButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentSecondaryButtonStyle}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Margin" Value="2,0,2,0"/>
    </Style>

</ResourceDictionary>
