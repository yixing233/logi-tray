<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>logi-tray</AssemblyName>
    <Product>logi-tray</Product>
    <Title>logi-tray</Title>
    <Version>1.1.0</Version>
    <RootNamespace>MouseBatteryTray</RootNamespace>
    <StartupObject>MouseBatteryTray.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 两个版本共用的源码（单一来源，避免复制分叉） -->
    <Compile Include="..\shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- 关于页面展示的应用图标（512×512 PNG） -->
    <Resource Include="app.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\lucide.ttf" />
    <Content Include="Fonts\lucide.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
