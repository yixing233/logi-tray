<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>logi-tray</AssemblyName>
    <Product>logi-tray</Product>
    <Title>logi-tray</Title>
    <Version>1.2.0</Version>
    <RootNamespace>MouseBatteryTray</RootNamespace>
    <StartupObject>MouseBatteryTray.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 涓や釜鐗堟湰鍏辩敤鐨勬簮鐮侊紙鍗曚竴鏉ユ簮锛岄伩鍏嶅鍒跺垎鍙夛級 -->
    <Compile Include="..\shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- 鍏充簬椤甸潰灞曠ず鐨勫簲鐢ㄥ浘鏍囷紙512脳512 PNG锛?-->
